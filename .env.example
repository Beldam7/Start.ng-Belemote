# Base URL of the startng-be API
VITE_API_URL=http://localhost:8000

# Public address of this site, used for canonical links and link previews (default https://start.ng)
VITE_SITE_URL=https://start.ng

# Google OAuth Web client ID (same value as GOOGLE_CLIENT_ID in startng-be)
# Authorized JavaScript origins must include this app URL
VITE_GOOGLE_CLIENT_ID=
